{
  "datasets": [
    {
      "name": "0754c2d1",
      "displayName": "daily_statistics",
      "queryLines": [
        "SELECT\n  post_id AS short_link,\n  post_publish_date,\n  analytics_date,\n  impressions,\n  engagements,\n  content,\n  title,\n  days_since_post AS days_after_post\nFROM gold.linkedin.fct_daily_profile_statistics\nWHERE post_id NOT IN ('others', 'total')"
      ]
    },
    {
      "name": "bde6b5ff",
      "displayName": "first_day_statistics",
      "queryLines": [
        "SELECT\n  post_id AS short_link,\n  post_publish_date,\n  analytics_date,\n  impressions,\n  engagements,\n  content,\n  title,\n  days_since_post AS days_after_post\nFROM gold.linkedin.fct_daily_profile_statistics\nWHERE post_id NOT IN ('others', 'total')\nAND post_publish_date = analytics_date\nORDER BY impressions DESC"
      ]
    },
    {
      "name": "4b464c92",
      "displayName": "total_statistics",
      "queryLines": [
        "SELECT short_link, post_publish_date, SUM(impressions) AS total_impressions, SUM(engagements) AS total_engagements, content\r\n",
        "FROM (\r\n",
        "SELECT\r\n  post_id AS short_link,\r\n  post_publish_date,\r\n  analytics_date,\r\n  impressions,\r\n  engagements,\r\n  content,\r\n  title,\r\n  days_since_post AS days_after_post\r\nFROM gold.linkedin.fct_daily_profile_statistics\r\nWHERE post_id NOT IN ('others', 'total')",
        ") stats\r\n",
        "GROUP BY short_link, post_publish_date, content"
      ]
    },
    {
      "name": "5350ba1e",
      "displayName": "days_after_statistics",
      "queryLines": [
        "SELECT\n  post_id AS short_link,\n  post_publish_date,\n  analytics_date,\n  impressions,\n  engagements,\n  content,\n  title,\n  days_since_post AS days_after_post\nFROM gold.linkedin.fct_daily_profile_statistics\nWHERE post_id NOT IN ('others', 'total')"
      ]
    },
    {
      "name": "b0f96c00",
      "displayName": "total_daily_statistics",
      "queryLines": [
        "SELECT analytics_date, impressions, engagements\r\n",
        "FROM gold.linkedin.fct_daily_post_statistics\r\n",
        "ORDER BY analytics_date"
      ]
    },
    {
      "name": "32629a54",
      "displayName": "historical_daily_statistics",
      "queryLines": [
        "SELECT * FROM gold.linkedin.fct_daily_post_statistics"
      ]
    }
  ],
